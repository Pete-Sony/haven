{
  "name": "haven",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@node-minify/core@8.0.6": "10.5.0",
    "@node-minify/terser@8.0.6": "10.5.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "node tools/fix-opennext-node-minify.mjs && opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:scan": "node tools/secret-scan.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run security:scan && npm run audit:dependencies && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^1.26.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.114.0"
  }
}
