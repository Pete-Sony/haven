# Optional. Without this key, Haven uses a reviewed deterministic fallback.
GEMINI_API_KEY=

# Optional saved-plan account. The immediate path never requires these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_OAUTH_ENABLED=false

# 32 random bytes encoded as base64. Required only when saved plans are enabled.
HAVEN_DATA_ENCRYPTION_KEY=

# HMAC secret used to hash rate-limit identities without storing raw addresses.
RATE_LIMIT_HMAC_KEY=
